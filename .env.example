# Required: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your Discord user ID, enables the owner-only /usage command.
# OWNER_ID=000000000000000000

# Optional: the timezone everyone uses by default, e.g. +01:00 or +05:30.
# Users do not have to choose anything; this applies automatically.
# Without this, days roll over at UTC midnight.
DEFAULT_OFFSET=+01:00

# Optional: where to store the SQLite database (default: wird.db).
# On Render, mount a persistent disk and set this, or progress is wiped on every deploy.
# DATABASE_PATH=/var/data/wird.db

# Optional: change the log level.
# RUST_LOG=wird=debug
